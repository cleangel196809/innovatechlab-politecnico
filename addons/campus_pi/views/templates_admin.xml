<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="admin_create_course" name="Admin - crear curso con IA">
        <t t-call="campus_pi.layout">
            <section class="cp-hero">
                <div>
                    <p class="cp-eyebrow">Agente de diseño instruccional</p>
                    <h1>🤖 Crear curso a partir del syllabus</h1>
                    <p>Sube el syllabus institucional (PI-GA-FT-141) en Word o PDF. El agente lee núcleos, objetivos, criterios de evaluación y bibliografía; <b>investiga en la web</b> la versión vigente de la certificación, novedades y recursos por núcleo; y crea todo el curso: lecturas con fuentes, presentaciones, infografías, guiones de video, actividades, laboratorios, evaluaciones con rúbrica, sesiones virtuales, sesiones presenciales asistidas por IA, cuestionarios, banco del simulador y cronograma.</p>
                </div>
            </section>
            <div t-if="not ai_enabled" class="cp-alert">⚠️ No hay proveedor de IA configurado: el agente trabajará en <b>modo sin IA</b> (todo se arma solo con el syllabus). Configure una clave gratuita de Gemini o Groq (o Claude/ChatGPT) en <a href="/campus/admin/ia">Proveedor de IA</a> o en las variables de Render.</div>
            <div t-else="" class="cp-alert cp-alert-ok">🤖 Proveedor de IA activo: <b t-esc="ai_label"/> (<a href="/campus/admin/ia">cambiar</a>)<t t-if="not ai_search"> · sin búsqueda web (los datos de la certificación quedarán marcados para verificar)</t>.</div>
            <div t-if="error" class="cp-alert cp-alert-error" t-esc="error"/>
            <form method="post" enctype="multipart/form-data" class="cp-card cp-form cp-form-grid" data-cp-encode="syllabus">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                <div class="cp-span-2">
                    <label>Nombre del curso</label>
                    <input name="name" required="required" placeholder="Ej.: Desarrollo Backend con Java y Spring Boot"/>
                </div>
                <div class="cp-span-2">
                    <label>Syllabus (PDF, DOCX o TXT)</label>
                    <input type="file" name="syllabus" accept=".pdf,.docx,.txt" required="required"/>
                </div>
                <div>
                    <label>Certificación internacional objetivo</label>
                    <select name="certification_id">
                        <option value="auto" selected="selected">🔎 Detectar en el syllabus / investigar (recomendado)</option>
                        <option value="">— Ninguna —</option>
                        <option t-foreach="certs" t-as="c" t-att-value="c.id"><t t-esc="c.provider"/> · <t t-esc="c.name"/> (<t t-esc="c.exam_code"/>)</option>
                    </select>
                </div>
                <div>
                    <label>Modalidad</label>
                    <select name="modality">
                        <option value="virtual">Virtual</option>
                        <option value="hibrida">Híbrida (virtual + presencial asistida por IA)</option>
                        <option value="presencial">Presencial asistida por IA</option>
                    </select>
                </div>
                <div><label>Fecha de inicio</label><input type="date" name="date_start" required="required"/></div>
                <div><label>Fecha de fin</label><input type="date" name="date_end" required="required"/></div>
                <div>
                    <label>Docentes</label>
                    <div class="cp-checklist">
                        <label t-foreach="teachers" t-as="t" class="cp-check-item"><input type="checkbox" name="teacher_ids" t-att-value="t.id"/> <t t-esc="t.name"/></label>
                    </div>
                </div>
                <div>
                    <label>Anexar estudiantes</label>
                    <div class="cp-checklist">
                        <label t-foreach="students" t-as="s" class="cp-check-item"><input type="checkbox" name="student_ids" t-att-value="s.id"/> <t t-esc="s.name"/> <small t-esc="s.login"/></label>
                    </div>
                </div>
                <div class="cp-span-2">
                    <label>Instrucciones adicionales para el agente</label>
                    <textarea name="instructions" rows="3" placeholder="Ej.: Incluir un laboratorio con Docker en cada núcleo; énfasis en casos de MiPymes colombianas; 2 sesiones presenciales por núcleo."/>
                </div>
                <div class="cp-span-2">
                    <label class="cp-check-item"><input type="checkbox" name="deep_research" value="1" checked="checked"/> Hacer investigación profunda en la web (certificación vigente, novedades y recursos con fuentes)</label>
                </div>
                <div class="cp-span-2 cp-row">
                    <button class="cp-btn cp-btn-primary cp-btn-lg">Generar curso con el agente</button>
                    <span class="cp-muted cp-small">El agente trabaja en segundo plano y verás su avance en vivo (con IA e investigación: 5 a 15 minutos).</span>
                </div>
            </form>
            <div class="cp-card" t-if="jobs">
                <h3>Ejecuciones recientes del agente</h3>
                <table class="cp-table">
                    <tr><th>Curso</th><th>Estado</th><th>Avance</th><th>Fecha</th><th/></tr>
                    <tr t-foreach="jobs" t-as="j">
                        <td t-esc="j.name"/>
                        <td><t t-esc="dict(j._fields['state'].selection).get(j.state)"/></td>
                        <td><t t-esc="j.progress"/> %</td>
                        <td t-esc="j.create_date" t-options="{'widget': 'datetime', 'format': 'd MMM, h:mm a'}"/>
                        <td><a t-attf-href="/campus/admin/agente/#{j.id}">Ver avance →</a></td>
                    </tr>
                </table>
            </div>
        </t>
    </template>

    <template id="admin_agent_job" name="Admin - avance del agente">
        <t t-call="campus_pi.layout">
            <t t-set="title" t-value="'Agente · ' + job.name"/>
            <section class="cp-hero">
                <div>
                    <p class="cp-eyebrow">Agente de diseño instruccional</p>
                    <h1>🤖 <t t-esc="job.name"/></h1>
                    <p><t t-esc="job.syllabus_filename"/> · <t t-esc="job.provider or ('Con IA' if job.use_ai else 'Modo sin IA (solo syllabus)')"/></p>
                </div>
            </section>
            <div class="cp-card cp-job" id="cp-job" t-att-data-url="'/campus/admin/agente/%s/estado' % job.id">
                <div class="cp-job-head">
                    <b id="cp-job-stage" t-esc="job.stage and dict(stages).get(job.stage) or 'En cola'"/>
                    <span id="cp-job-pct"><t t-esc="job.progress"/> %</span>
                </div>
                <div class="cp-progress cp-progress-lg"><div id="cp-job-bar" t-attf-style="width: #{job.progress}%"/></div>
                <ol class="cp-job-steps">
                    <li t-foreach="stages" t-as="st" t-att-data-stage="st[0]" t-esc="st[1]"/>
                </ol>
                <div id="cp-job-done" class="cp-alert cp-alert-ok" t-att-hidden="None if job.state == 'done' else 'hidden'">
                    ✅ Curso generado. <a id="cp-job-link" t-att-href="'/campus/curso/%s' % job.course_id.id if job.course_id else '#'" class="cp-btn cp-btn-primary cp-btn-sm">Abrir el curso</a>
                    <a href="/campus/admin/cursos" class="cp-btn cp-btn-ghost cp-btn-sm">Programar y publicar</a>
                </div>
                <div id="cp-job-error" class="cp-alert cp-alert-error" t-att-hidden="None if job.state == 'error' else 'hidden'">
                    <span id="cp-job-error-msg"><t t-esc="job.error or ''"/></span>
                    <form method="post" t-attf-action="/campus/admin/agente/#{job.id}/reintentar" style="display:inline">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <button class="cp-btn cp-btn-primary cp-btn-sm">Reintentar</button>
                    </form>
                </div>
                <h4>Bitácora</h4>
                <pre id="cp-job-log" class="cp-job-log"><t t-esc="job.log or ''"/></pre>
            </div>
        </t>
    </template>


    <template id="admin_ai_settings" name="Admin - proveedor de IA">
        <t t-call="campus_pi.layout">
            <section class="cp-hero">
                <div>
                    <p class="cp-eyebrow">Administración</p>
                    <h1>🧠 Proveedor de inteligencia artificial</h1>
                    <p>El tutor IA, el agente de creación de cursos y los planes de tutoría usan el proveedor activo. Para pruebas puede usar uno gratuito (Gemini o Groq) y luego cambiar a Claude o ChatGPT sin tocar el código.</p>
                </div>
            </section>
            <div t-if="msg" class="cp-alert cp-alert-ok" t-esc="msg"/>
            <div class="cp-cols">
                <form method="post" class="cp-card cp-form">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <input type="hidden" name="action" value="save"/>
                    <h3>Configuración</h3>
                    <label>Proveedor</label>
                    <select name="provider">
                        <option value="" t-att-selected="'selected' if not provider else None">Automático (el primero con clave)</option>
                        <option t-foreach="status" t-as="p" t-att-value="p['code']" t-att-selected="'selected' if provider == p['code'] else None" t-esc="p['label']"/>
                    </select>
                    <t t-foreach="status" t-as="p">
                        <label>Clave de <t t-esc="p['label']"/>
                            <small t-if="p['configured']" class="cp-ok-text"> · configurada <t t-esc="p['hint']"/><t t-if="p['from_env']"> (variable de Render)</t></small></label>
                        <input type="password" t-att-name="'key_%s' % p['code']" autocomplete="off" placeholder="Pegue la clave para cambiarla (vacío = no cambiar)"/>
                        <label t-if="p['configured'] and not p['from_env']" class="cp-inline"><input type="checkbox" t-att-name="'clear_%s' % p['code']" value="1"/> borrar esta clave</label>
                    </t>
                    <label>Modelo (opcional)</label>
                    <input name="model" t-att-value="model" placeholder="Vacío = recomendado (p. ej. gemini-flash-latest, llama-3.3-70b-versatile)"/>
                    <label>URL base (solo «compatible con OpenAI»)</label>
                    <input name="base_url" t-att-value="base_url" placeholder="https://openrouter.ai/api/v1"/>
                    <button class="cp-btn cp-btn-primary">Guardar</button>
                </form>
                <div>
                    <div class="cp-card">
                        <h3>Activo ahora</h3>
                        <p><b t-esc="active"/></p>
                        <form method="post">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <input type="hidden" name="action" value="test"/>
                            <button class="cp-btn cp-btn-ghost">Probar conexión</button>
                        </form>
                        <div t-if="test" t-attf-class="cp-alert #{'cp-alert-ok' if test['ok'] else 'cp-alert-error'}">
                            <b t-esc="'✔ Respondió' if test['ok'] else '✘ Falló'"/><t t-if="test.get('secs')"> en <t t-esc="test['secs']"/> s</t>: <t t-esc="test['text']"/>
                        </div>
                    </div>
                    <div class="cp-card">
                        <h3>Dónde obtener una clave</h3>
                        <table class="cp-table">
                            <tr><th>Proveedor</th><th>Costo</th><th>Búsqueda web</th></tr>
                            <tr><td>Gemini · <a href="https://aistudio.google.com/apikey" target="_blank">aistudio.google.com/apikey</a></td><td>Nivel gratuito con cupo diario</td><td>Sí, cuando el plan lo permite</td></tr>
                            <tr><td>Groq · <a href="https://console.groq.com/keys" target="_blank">console.groq.com/keys</a></td><td>Nivel gratuito con límites por minuto</td><td>No</td></tr>
                            <tr><td>Claude · <a href="https://platform.claude.com" target="_blank">platform.claude.com</a></td><td>De pago (créditos)</td><td>Sí</td></tr>
                            <tr><td>ChatGPT · <a href="https://platform.openai.com/api-keys" target="_blank">platform.openai.com</a></td><td>De pago</td><td>No (en esta integración)</td></tr>
                        </table>
                        <p class="cp-small cp-muted">Las claves quedan en la base de datos del campus; si prefiere, defínalas en Render como GEMINI_API_KEY, GROQ_API_KEY, ANTHROPIC_API_KEY u OPENAI_API_KEY (tienen prioridad). En los niveles gratuitos el proveedor puede usar los datos para mejorar sus modelos: no envíe información confidencial.</p>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="admin_courses" name="Admin - cursos">
        <t t-call="campus_pi.layout">
            <section class="cp-hero">
                <div>
                    <p class="cp-eyebrow">Administración</p>
                    <h1>🗓️ Cursos, programación e inscripciones</h1>
                    <p>Ajusta fechas, publica, anexa estudiantes y crea nuevas cuentas. Para editar contenidos y guiones usa “Editar en Odoo”.</p>
                </div>
            </section>
            <div t-if="nuevo" class="cp-alert cp-alert-ok">✅ El agente creó el curso. Revísalo, ajusta lo necesario y publícalo.</div>
            <div t-if="msg" class="cp-alert cp-alert-ok" t-esc="msg"/>
            <div class="cp-cols cp-cols-wide">
                <div>
                    <form t-foreach="courses" t-as="c" method="post" t-attf-action="/campus/admin/curso/#{c.id}/guardar"
                          t-attf-class="cp-card cp-admin-course #{'cp-highlight' if c.id == nuevo else ''}" t-attf-style="--accent: #{c.color or '#160B8B'}">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <div class="cp-section-head">
                            <h3><span t-esc="c.icon"/> <t t-esc="c.name"/> <small t-if="c.ai_generated" class="cp-pill">🤖 IA</small></h3>
                            <span class="cp-pill" t-esc="dict(c._fields['state'].selection).get(c.state)"/>
                        </div>
                        <p class="cp-muted cp-small"><t t-esc="c.certification_id.name or 'Sin certificación'"/> · <t t-esc="c.lesson_count"/> lecciones · <t t-esc="c.question_count"/> preguntas · <t t-esc="c.student_count"/> estudiantes</p>
                        <div class="cp-form-grid">
                            <div><label>Inicio</label><input type="date" name="date_start" t-att-value="c.date_start"/></div>
                            <div><label>Fin</label><input type="date" name="date_end" t-att-value="c.date_end"/></div>
                            <div><label>Estado</label>
                                <select name="state">
                                    <option value="draft" t-att-selected="c.state == 'draft'">Borrador</option>
                                    <option value="published" t-att-selected="c.state == 'published'">Publicado</option>
                                    <option value="closed" t-att-selected="c.state == 'closed'">Cerrado</option>
                                </select>
                            </div>
                            <div><label>Anexar estudiantes</label>
                                <select name="student_ids" multiple="multiple" size="3">
                                    <t t-foreach="students" t-as="s">
                                        <option t-if="s not in c.enrollment_ids.mapped('user_id')" t-att-value="s.id" t-esc="s.name"/>
                                    </t>
                                </select>
                            </div>
                        </div>
                        <p class="cp-small">Inscritos: <t t-esc="', '.join(c.enrollment_ids.mapped('user_id.name')) or '—'"/></p>
                        <div class="cp-row">
                            <button class="cp-btn cp-btn-primary cp-btn-sm">Guardar</button>
                            <a t-attf-href="/campus/curso/#{c.id}" class="cp-btn cp-btn-ghost cp-btn-sm">Ver como aula</a>
                            <a t-attf-href="/web#model=campus.course&amp;id=#{c.id}&amp;view_type=form" class="cp-btn cp-btn-ghost cp-btn-sm">Editar en Odoo</a>
                        </div>
                    </form>
                </div>
                <div>
                    <form method="post" action="/campus/admin/estudiante/crear" class="cp-card cp-form">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <h3>➕ Crear estudiante</h3>
                        <label>Nombre completo</label><input name="name" required="required"/>
                        <label>Correo institucional (usuario)</label><input type="email" name="email" required="required" placeholder="nombre@pi.edu.co"/>
                        <label>Contraseña inicial</label><input type="text" name="password" required="required" minlength="8"/>
                        <button class="cp-btn cp-btn-primary">Crear cuenta</button>
                    </form>
                    <div class="cp-card">
                        <h3>Atajos</h3>
                        <a href="/campus/admin/crear-curso" class="cp-btn cp-btn-primary cp-btn-block">🤖 Crear curso con IA</a>
                        <a href="/web#action=campus_pi.action_sessions" class="cp-btn cp-btn-ghost cp-btn-block">Calendario de sesiones</a>
                        <a href="/web#action=campus_pi.action_enrollment" class="cp-btn cp-btn-ghost cp-btn-block">Inscripciones (análisis)</a>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>
