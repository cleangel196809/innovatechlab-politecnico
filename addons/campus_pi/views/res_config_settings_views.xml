<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_settings_campus" model="ir.ui.view">
        <field name="name">res.config.settings.campus</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Campus PI" string="Campus PI" name="campus_pi">
                    <block title="Agentes de IA">
                        <setting string="Proveedor" help="También se puede configurar desde el campus: Crear curso con IA → Proveedor de IA.">
                            <field name="campus_ai_provider"/>
                        </setting>
                        <setting string="Gemini" help="Gratis en aistudio.google.com/apikey"><field name="campus_gemini_api_key" password="True"/></setting>
                        <setting string="Groq" help="Gratis en console.groq.com/keys"><field name="campus_groq_api_key" password="True"/></setting>
                        <setting string="Anthropic"><field name="campus_anthropic_api_key" password="True"/></setting>
                        <setting string="OpenAI"><field name="campus_openai_api_key" password="True"/></setting>
                        <setting string="Compatible con OpenAI"><field name="campus_compatible_api_key" password="True"/><field name="campus_ai_base_url" placeholder="https://openrouter.ai/api/v1"/></setting>
                        <setting string="Modelo" help="Vacío = modelo recomendado del proveedor."><field name="campus_ai_model"/></setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
    <record id="action_campus_settings" model="ir.actions.act_window">
        <field name="name">Configuración</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module': 'campus_pi'}</field>
    </record>
</odoo>
