<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="campus_login" name="Campus login">
        <t t-call="campus_pi.layout">
            <t t-set="hide_nav" t-value="True"/>
            <t t-set="body_class" t-value="'cp-login-body'"/>
            <t t-set="title" t-value="'Ingreso · InnovaTech Lab'"/>
            <div class="cp-login-wrap">
                <section class="cp-login-side">
                    <p class="cp-eyebrow">InnovaTech Lab</p>
                    <h2>Certifícate con el respaldo del <b>Politécnico Internacional</b></h2>
                </section>
                <section class="cp-login-card">
                    <div class="cp-login-logos">
                        <img src="/campus_pi/static/src/img/isologo_pi.png" class="cp-login-logo-pi" alt="Isologo Politécnico Internacional"/>
                        <span class="cp-login-logos-sep" aria-hidden="true"/>
                        <img src="/campus_pi/static/src/img/innovatech_lab.png" class="cp-login-logo-lab" alt="Isologo InnovaTech Lab – Laboratorio de Innovación Tecnológica para el Aprendizaje"/>
                    </div>
                    <h1 class="cp-sr-only">InnovaTech Lab · Politécnico Internacional</h1>
                    <form method="post" action="/campus/login" class="cp-form">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <label for="login">Usuario</label>
                        <input type="email" id="login" name="login" t-att-value="login" placeholder="usuario@pi.edu.co" required="required" autofocus="autofocus" autocomplete="username"/>
                        <label for="password">Contraseña</label>
                        <input type="password" id="password" name="password" placeholder="Tu contraseña" required="required" autocomplete="current-password"/>
                        <div t-if="error" class="cp-alert cp-alert-error" t-esc="error"/>
                        <div t-if="info" class="cp-alert cp-alert-ok" t-esc="info"/>
                        <button type="submit" class="cp-btn cp-btn-primary cp-btn-block">Ingresar</button>
                    </form>
                    <p class="cp-muted cp-center">¿Olvidaste tu contraseña? <a href="/campus/recuperar">Recupérala aquí</a></p>
                </section>
            </div>
        </t>
    </template>

    <!-- Marca institucional también en el login estándar de Odoo (/web/login) -->
    <template id="web_login_brand" inherit_id="web.login" name="Campus PI login brand">
        <xpath expr="//form" position="before">
            <div class="text-center mb-3 cp-weblogin-brand">
                <img src="/campus_pi/static/src/img/isologo_pi.png" style="max-height:90px" alt="Politécnico Internacional"/>
                <img src="/campus_pi/static/src/img/innovatech_lab.png" style="max-height:80px;max-width:100%;margin-top:10px" alt="InnovaTech Lab"/>
            </div>
        </xpath>
    </template>
    <template id="campus_account" name="Campus · contraseña">
        <t t-call="campus_pi.layout">
            <t t-set="hide_nav" t-value="True"/>
            <t t-set="body_class" t-value="'cp-login-body'"/>
            <t t-set="title" t-value="'Contraseña · InnovaTech Lab'"/>
            <div class="cp-login-wrap">
                <section class="cp-login-side">
                    <p class="cp-eyebrow">InnovaTech Lab</p>
                    <h2 t-if="mode == 'recover'">Recupera el acceso a tu <b>campus</b></h2>
                    <h2 t-elif="mode == 'change'">Bienvenido. Crea tu <b>contraseña personal</b></h2>
                    <h2 t-else="">Define tu <b>nueva contraseña</b></h2>
                </section>
                <section class="cp-login-card">
                    <div class="cp-login-logos">
                        <img src="/campus_pi/static/src/img/isologo_pi.png" class="cp-login-logo-pi" alt="Isologo Politécnico Internacional"/>
                        <span class="cp-login-logos-sep" aria-hidden="true"/>
                        <img src="/campus_pi/static/src/img/innovatech_lab.png" class="cp-login-logo-lab" alt="Isologo InnovaTech Lab"/>
                    </div>
                    <div t-if="error" class="cp-alert cp-alert-error" t-esc="error"/>
                    <div t-if="info" class="cp-alert cp-alert-ok" t-esc="info"/>
                    <form t-if="mode == 'recover' and not sent" method="post" action="/campus/recuperar" class="cp-form">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <p class="cp-small cp-muted">Escribe el correo con el que ingresas. Te enviaremos un enlace para crear una contraseña nueva (válido 2 horas).</p>
                        <label for="email">Correo</label>
                        <input type="email" id="email" name="email" required="required" autofocus="autofocus" autocomplete="username" placeholder="usuario@pi.edu.co"/>
                        <button type="submit" class="cp-btn cp-btn-primary cp-btn-block">Enviar enlace al correo</button>
                    </form>
                    <form t-if="mode in ('reset', 'change') and not done" method="post" t-att-action="action" class="cp-form">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <input t-if="token" type="hidden" name="token" t-att-value="token"/>
                        <p t-if="mode == 'change'" class="cp-small cp-muted">Ingresaste con la contraseña inicial. Por seguridad, cámbiala antes de continuar.</p>
                        <p t-if="account" class="cp-small">Cuenta: <b t-esc="account"/></p>
                        <t t-if="mode == 'change'">
                            <label for="old">Contraseña actual</label>
                            <input type="password" id="old" name="old_password" required="required" autocomplete="current-password"/>
                        </t>
                        <label for="new">Nueva contraseña</label>
                        <input type="password" id="new" name="new_password" required="required" minlength="8" autocomplete="new-password"/>
                        <label for="new2">Repite la nueva contraseña</label>
                        <input type="password" id="new2" name="confirm_password" required="required" minlength="8" autocomplete="new-password"/>
                        <p class="cp-small cp-muted">Mínimo 8 caracteres, con letras y números.</p>
                        <button type="submit" class="cp-btn cp-btn-primary cp-btn-block">Guardar contraseña</button>
                    </form>
                    <p class="cp-muted cp-center"><a href="/campus/login">Volver al ingreso</a></p>
                </section>
            </div>
        </t>
    </template>
</odoo>
