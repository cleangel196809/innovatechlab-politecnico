<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="campus_login" name="Campus login">
        <t t-call="campus_pi.layout">
            <t t-set="hide_nav" t-value="True"/>
            <t t-set="body_class" t-value="'cp-login-body'"/>
            <t t-set="title" t-value="'Ingreso · InnobaTech Lab'"/>
            <div class="cp-login-wrap">
                <section class="cp-login-side">
                    <h2>Certifícate con el respaldo del <b>Politécnico Internacional</b></h2>
                    <ul>
                        <li>🤖 Cursos diseñados por un agente de IA a partir del syllabus institucional</li>
                        <li>🎯 Simulador del examen internacional con analítica por dominio</li>
                        <li>👩‍🏫 Tutoría con docente y tutor IA disponible 24/7</li>
                        <li>🏅 Microcredenciales verificables en línea</li>
                    </ul>
                    <a href="/campus/valor" class="cp-link-light">¿Por qué esta plataforma y no Moodle? →</a>
                </section>
                <section class="cp-login-card">
                    <img src="/campus_pi/static/src/img/isologo_pi.png" class="cp-login-logo" alt="Isologo Politécnico Internacional"/>
                    <h1 class="cp-login-title">Plataforma de innovación tecnológica y laboratorio de capacitación para obtener certificaciones internacionales</h1>
                    <form method="post" action="/campus/login" class="cp-form">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <label for="login">Usuario</label>
                        <input type="email" id="login" name="login" t-att-value="login" placeholder="usuario@pi.edu.co" required="required" autofocus="autofocus" autocomplete="username"/>
                        <label for="password">Contraseña</label>
                        <input type="password" id="password" name="password" placeholder="••••••••" required="required" autocomplete="current-password"/>
                        <div t-if="error" class="cp-alert cp-alert-error" t-esc="error"/>
                        <button type="submit" class="cp-btn cp-btn-primary cp-btn-block">Ingresar</button>
                    </form>
                    <p class="cp-muted cp-center">¿Olvidaste tu contraseña? <a href="/web/reset_password">Recupérala aquí</a></p>
                </section>
            </div>
        </t>
    </template>

    <!-- Marca institucional también en el login estándar de Odoo (/web/login) -->
    <template id="web_login_brand" inherit_id="web.login" name="Campus PI login brand">
        <xpath expr="//form" position="before">
            <div class="text-center mb-3 cp-weblogin-brand">
                <img src="/campus_pi/static/src/img/isologo_pi.png" style="max-height:110px" alt="Politécnico Internacional"/>
                <p class="small mt-2" style="color:#160B8B;font-weight:600">Plataforma de innovación tecnológica y laboratorio de capacitación para obtener certificaciones internacionales</p>
            </div>
        </xpath>
    </template>
</odoo>
