<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_question_tree" model="ir.ui.view">
        <field name="name">campus.question.tree</field>
        <field name="model">campus.question</field>
        <field name="arch" type="xml">
            <tree>
                <field name="course_id"/><field name="domain"/><field name="name"/>
                <field name="difficulty"/><field name="source"/>
            </tree>
        </field>
    </record>
    <record id="view_question_form" model="ir.ui.view">
        <field name="name">campus.question.form</field>
        <field name="model">campus.question</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group><field name="course_id"/><field name="domain"/></group>
                        <group><field name="difficulty"/><field name="source"/><field name="active"/></group>
                    </group>
                    <field name="name" placeholder="Enunciado"/>
                    <field name="option_ids">
                        <tree editable="bottom">
                            <field name="sequence" widget="handle"/><field name="name"/>
                            <field name="is_correct"/><field name="feedback"/>
                        </tree>
                    </field>
                    <group><field name="explanation"/></group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_question_search" model="ir.ui.view">
        <field name="name">campus.question.search</field>
        <field name="model">campus.question</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/><field name="course_id"/><field name="domain"/>
                <group expand="0" string="Agrupar">
                    <filter name="g_course" string="Curso" context="{'group_by': 'course_id'}"/>
                    <filter name="g_domain" string="Dominio" context="{'group_by': 'domain'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_question" model="ir.actions.act_window">
        <field name="name">Banco de preguntas del simulador</field>
        <field name="res_model">campus.question</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_g_course': 1}</field>
    </record>
</odoo>
