<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_course_kanban" model="ir.ui.view">
        <field name="name">campus.course.kanban</field>
        <field name="model">campus.course</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="color"/><field name="icon"/><field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click" t-attf-style="border-top: 5px solid #{record.color.raw_value}">
                            <div class="o_kanban_record_title fs-5"><t t-esc="record.icon.value"/> <field name="name"/></div>
                            <div class="text-muted"><field name="certification_id"/></div>
                            <div class="mt-2">
                                <span class="badge text-bg-primary"><field name="student_count"/> estudiantes</span>
                                <span class="badge text-bg-info ms-1"><field name="lesson_count"/> lecciones</span>
                                <span class="badge text-bg-secondary ms-1"><field name="state"/></span>
                            </div>
                            <div class="text-muted small mt-1"><field name="date_start"/> → <field name="date_end"/></div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <record id="view_course_tree" model="ir.ui.view">
        <field name="name">campus.course.tree</field>
        <field name="model">campus.course</field>
        <field name="arch" type="xml">
            <tree>
                <field name="code"/><field name="name"/><field name="certification_id"/>
                <field name="modality"/><field name="date_start"/><field name="date_end"/>
                <field name="student_count"/><field name="state" widget="badge"/>
            </tree>
        </field>
    </record>
    <record id="view_course_form" model="ir.ui.view">
        <field name="name">campus.course.form</field>
        <field name="model">campus.course</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_publish" type="object" string="Publicar" class="btn-primary" invisible="state == 'published'"/>
                    <button name="action_close" type="object" string="Cerrar curso" invisible="state != 'published'"/>
                    <button name="action_open_campus" type="object" string="Ver en el campus"/>
                    <button name="action_ai_generate_questions" type="object" string="🤖 Generar 10 preguntas con IA"/>
                    <button name="%(action_gift_import)d" type="action" string="Importar GIFT (Moodle)" context="{'default_course_id': id}"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <field name="image" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <h1><field name="icon" class="oe_inline" style="width:3em"/> <field name="name" placeholder="Nombre del curso"/></h1>
                        <field name="subtitle" placeholder="Subtítulo"/>
                    </div>
                    <group>
                        <group>
                            <field name="code"/><field name="certification_id"/>
                            <field name="modality"/><field name="level"/><field name="hours"/>
                        </group>
                        <group>
                            <field name="date_start"/><field name="date_end"/>
                            <field name="teacher_ids" widget="many2many_tags"/>
                            <field name="color" widget="color"/><field name="ai_generated"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Núcleos y lecciones">
                            <field name="section_ids">
                                <tree>
                                    <field name="sequence" widget="handle"/><field name="name"/>
                                    <field name="date_start"/><field name="date_end"/>
                                </tree>
                                <form>
                                    <group>
                                        <field name="name"/><field name="objective"/>
                                        <field name="date_start"/><field name="date_end"/>
                                    </group>
                                    <field name="lesson_ids">
                                        <tree>
                                            <field name="sequence" widget="handle"/><field name="name"/>
                                            <field name="lesson_type"/><field name="duration_min"/>
                                            <field name="session_datetime"/>
                                        </tree>
                                        <form>
                                            <group>
                                                <group><field name="name"/><field name="lesson_type"/><field name="duration_min"/><field name="summary"/></group>
                                                <group><field name="session_datetime"/><field name="meeting_url" widget="url"/><field name="location"/><field name="video_url"/><field name="resource_url" widget="url"/><field name="attachment" filename="attachment_name"/><field name="attachment_name" invisible="1"/></group>
                                            </group>
                                            <notebook>
                                                <page string="Contenido"><field name="content"/></page>
                                                <page string="Guion del agente IA"><field name="ai_guide"/></page>
                                            </notebook>
                                        </form>
                                    </field>
                                </form>
                            </field>
                        </page>
                        <page string="Estudiantes inscritos">
                            <field name="enrollment_ids">
                                <tree editable="bottom">
                                    <field name="user_id" domain="[('groups_id', 'in', %(group_campus_student)d)]"/>
                                    <field name="date"/><field name="progress" widget="progressbar"/>
                                    <field name="best_score"/><field name="state"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Banco del simulador">
                            <field name="question_ids">
                                <tree><field name="domain"/><field name="name"/><field name="source"/></tree>
                            </field>
                        </page>
                        <page string="Descripción">
                            <field name="description"/>
                            <separator string="Resultados de aprendizaje"/>
                            <field name="outcomes"/>
                            <group><field name="skills"/><field name="reference_model"/></group>
                        </page>
                        <page string="Agente IA">
                            <group>
                                <field name="syllabus_file" filename="syllabus_filename"/>
                                <field name="syllabus_filename" invisible="1"/>
                                <field name="tutor_prompt" placeholder="Ej.: Prioriza ejemplos con PostgreSQL. No resuelvas los casos integradores."/>
                                <field name="ai_log"/>
                            </group>
                            <separator string="Texto del syllabus (contexto)"/>
                            <field name="syllabus_text"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter"><field name="message_follower_ids"/><field name="message_ids"/></div>
            </form>
        </field>
    </record>
    <record id="action_course" model="ir.actions.act_window">
        <field name="name">Cursos</field>
        <field name="res_model">campus.course</field>
        <field name="view_mode">kanban,tree,form</field>
    </record>

    <record id="view_lesson_tree" model="ir.ui.view">
        <field name="name">campus.lesson.tree</field>
        <field name="model">campus.lesson</field>
        <field name="arch" type="xml">
            <tree>
                <field name="course_id"/><field name="section_id"/><field name="name"/>
                <field name="lesson_type"/><field name="session_datetime"/>
            </tree>
        </field>
    </record>
    <record id="view_lesson_calendar" model="ir.ui.view">
        <field name="name">campus.lesson.calendar</field>
        <field name="model">campus.lesson</field>
        <field name="arch" type="xml">
            <calendar date_start="session_datetime" color="course_id" mode="month" string="Programación">
                <field name="name"/><field name="lesson_type"/><field name="course_id"/>
            </calendar>
        </field>
    </record>
    <record id="action_sessions" model="ir.actions.act_window">
        <field name="name">Programación de sesiones</field>
        <field name="res_model">campus.lesson</field>
        <field name="view_mode">calendar,tree,form</field>
        <field name="domain">[('lesson_type', 'in', ('sesion_virtual', 'sesion_presencial'))]</field>
    </record>
</odoo>
