<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_gift_import" model="ir.ui.view">
        <field name="name">campus.gift.import.form</field>
        <field name="model">campus.gift.import</field>
        <field name="arch" type="xml">
            <form string="Importar preguntas GIFT">
                <p>Exporte el banco de preguntas desde Moodle en formato GIFT (.txt) y súbalo aquí.</p>
                <group>
                    <field name="course_id"/><field name="domain"/>
                    <field name="file" filename="filename"/><field name="filename" invisible="1"/>
                </group>
                <footer>
                    <button name="action_import" type="object" string="Importar" class="btn-primary"/>
                    <button special="cancel" string="Cancelar"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_gift_import" model="ir.actions.act_window">
        <field name="name">Importar GIFT</field>
        <field name="res_model">campus.gift.import</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
