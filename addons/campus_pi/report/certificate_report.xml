<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_cert" model="report.paperformat">
        <field name="name">Microcredencial horizontal</field>
        <field name="format">Letter</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">8</field><field name="margin_bottom">8</field>
        <field name="margin_left">8</field><field name="margin_right">8</field>
        <field name="header_line" eval="False"/><field name="header_spacing">0</field>
        <field name="dpi">96</field>
    </record>

    <record id="report_badge" model="ir.actions.report">
        <field name="name">Microcredencial</field>
        <field name="model">campus.badge</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">campus_pi.report_badge_document</field>
        <field name="report_file">campus_pi.report_badge_document</field>
        <field name="print_report_name">'Microcredencial-%s' % object.code</field>
        <field name="paperformat_id" ref="paperformat_cert"/>
        <field name="binding_model_id" ref="model_campus_badge"/>
    </record>

    <template id="report_badge_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="b">
              <t t-call="web.basic_layout">
                <div class="page" style="font-family: Helvetica, Arial, sans-serif;">
                    <div style="border: 10px solid #160B8B; padding: 36px; min-height: 640px; position: relative;">
                        <div style="border: 2px solid #6ACCEA; padding: 28px; min-height: 560px; text-align: center;">
                            <img t-att-src="b.logo_data_uri()" style="height: 120px;"/>
                            <div style="color:#6ACCEA; letter-spacing: 4px; font-size: 13px; margin-top: 8px;">INNOBATECH LAB · PLATAFORMA DE INNOVACIÓN TECNOLÓGICA</div>
                            <h1 style="color:#160B8B; font-size: 40px; margin: 18px 0 6px;">MICROCREDENCIAL</h1>
                            <div style="font-size: 16px;">El Politécnico Internacional certifica que</div>
                            <div style="font-size: 32px; color:#160B8B; font-weight: bold; margin: 12px 0;" t-esc="b.user_id.name"/>
                            <div style="font-size: 16px;">aprobó la ruta de formación</div>
                            <div style="font-size: 24px; font-weight: bold; margin: 8px 0;" t-esc="b.course_id.name"/>
                            <div style="font-size: 15px;" t-if="b.certification_id">
                                preparatoria para <b t-esc="b.certification_id.name"/>
                                (<span t-esc="b.certification_id.provider"/> <span t-esc="b.certification_id.exam_code"/>)
                            </div>
                            <div style="font-size: 14px; margin-top: 14px;">
                                Simulador de certificación: <b><t t-esc="'%.1f' % b.score"/> %</b> ·
                                Intensidad: <b t-esc="b.course_id.hours"/> horas ·
                                Fecha: <b t-esc="b.date"/>
                            </div>
                            <div style="margin-top: 26px; font-size: 12px; color: #555;">
                                Código de verificación: <b t-esc="b.code"/><br/>
                                Verifique en: /campus/verificar/<t t-esc="b.code"/>
                            </div>
                            <div style="margin-top: 10px; font-size: 10px; color: #888;">
                                Esta microcredencial institucional no reemplaza el examen oficial del proveedor; acredita la preparación para presentarlo.
                            </div>
                        </div>
                    </div>
                </div>
              </t>
            </t>
        </t>
    </template>
</odoo>
